#!/bin/sh
# In-container shim that asks the host bridge daemon to open a URL.
# Used as $BROWSER so OAuth-style CLIs trigger the host browser.
set -eu

url="${1:-}"
if [ -z "$url" ]; then
    echo "host-browser: no URL argument" >&2
    exit 1
fi
if [ -z "${HOST_BRIDGE_URL:-}" ] || [ -z "${HOST_BRIDGE_PASS:-}" ]; then
    echo "host-browser: HOST_BRIDGE_URL / HOST_BRIDGE_PASS not set" >&2
    exit 1
fi

exec curl -fsS \
    -u "container:$HOST_BRIDGE_PASS" \
    --data-urlencode "url=$url" \
    "${HOST_BRIDGE_URL}open" >/dev/null
