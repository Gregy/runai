# Claude Code on Bedrock: copy to bedrock.env (untracked) and edit. run.sh
# --bedrock passes it to the container via docker --env-file, so the format is
# KEY=VALUE, no quotes, no shell expansion; a bare KEY passes the host's value
# through. Variables forwarded by --aws (e.g. AWS_PROFILE) override this file.
# Claude Code does not read the region from ~/.aws/config, so set it here.
AWS_REGION=us-east-1
#AWS_PROFILE=my-profile
#AWS_BEARER_TOKEN_BEDROCK
#ANTHROPIC_MODEL=
#ANTHROPIC_DEFAULT_OPUS_MODEL=
#ANTHROPIC_DEFAULT_SONNET_MODEL=
#ANTHROPIC_DEFAULT_HAIKU_MODEL=
